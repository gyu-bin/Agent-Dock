# Agent Deck local environment (never commit real secrets)
PORT=8787

# OpenAI — required for REAL AI mode (server-only)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Codex CLI — Phase 3-B repository execution (server-only)
# CODEX_BIN=/absolute/path/to/codex
# CODEX_API_KEY=  # optional; falls back to OPENAI_API_KEY
# CODEX_TIMEOUT_MS=180000

# Optional overrides
# AGENT_DECK_AGENTS_DIR=/Users/you/.codex/agents
# AGENT_DECK_AGENCY_DIR=/Users/you/Desktop/Coding/agency-agents
# AGENT_DECK_DATA_FILE=./server/data/projects.json

# Client (Vite) — leave empty on Vercel (same-origin /api)
# VITE_API_URL=

# Cloud / Vercel serverless (set in Vercel dashboard, not required locally)
# AGENT_DECK_CLOUD=1
# AGENT_DECK_SESSION_TOKEN=  # openssl rand -hex 32
# AGENT_DECK_ALLOWED_ORIGINS=https://your-app.vercel.app

