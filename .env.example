# Agent Deck local environment (never commit real secrets)
PORT=8787

# OpenAI — required for REAL AI mode (server-only)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Codex CLI — Phase 3-B repository execution (server-only)
# CODEX_BIN=/absolute/path/to/codex
# CODEX_API_KEY=  # optional; falls back to OPENAI_API_KEY
# CODEX_TIMEOUT_MS=180000

# Optional overrides
# AGENT_DECK_AGENTS_DIR=/Users/you/.codex/agents
# AGENT_DECK_AGENCY_DIR=/Users/you/Desktop/Coding/agency-agents
# AGENT_DECK_DATA_FILE=./server/data/projects.json
# AGENT_DECK_ATTACHMENTS_DIR=./server/data/attachments
# AGENT_DECK_ATTACHMENTS_META_DIR=./server/data/attachments-meta

# Client (Vite) — leave empty on Vercel (same-origin /api)
# VITE_API_URL=

# Cloud / Vercel serverless (set in Vercel dashboard, not required locally)
# Data is persisted to Supabase table public.fs_files; login is Supabase Auth
# (email magic link) restricted to AGENT_DECK_ALLOWED_EMAILS. Fails closed.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=           # publishable/anon key (sent to the browser for login)
# SUPABASE_SERVICE_ROLE_KEY=   # secret key (sb_secret_…) or legacy service_role — server only, never VITE_*
# AGENT_DECK_ALLOWED_EMAILS=you@example.com
# CRON_SECRET=                 # openssl rand -hex 32 — Vercel Cron → /api/cron/routines
# AGENT_DECK_CLOUD=1           # only to emulate cloud mode outside Vercel
# AGENT_DECK_ALLOWED_ORIGINS=https://your-app.vercel.app

# Threads API (Meta) — server-only OAuth / publish
# https://developers.facebook.com/docs/threads/
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=http://127.0.0.1:8787/api/social/threads/oauth/callback
# AGENT_DECK_CLIENT_ORIGIN=http://127.0.0.1:5173
# AGENT_DECK_CREDENTIALS_DIR=./server/data/credentials

# Media Delivery (temporary public URLs for SNS — never expose local server)
# MEDIA_DELIVERY_PROVIDER=unconfigured
# MEDIA_DELIVERY_PROVIDER=fake   # fixtures/dev only — never production fallback
# MEDIA_DELIVERY_PROVIDER=s3-compatible
# MEDIA_DELIVERY_TTL_SECONDS=1800
#
# Cloudflare R2 (S3-compatible) — server-only credentials
# MEDIA_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# AGENT_DECK_MEDIA_DELIVERY_DIR=./server/data/media-delivery
#
# Live R2 smoke (tools/media-delivery-r2-smoke.mts) — opt-in only
# AGENT_DECK_LIVE_MEDIA_TEST=1

# Buffer GraphQL API — server-only Personal API Key (never expose to client)
# https://developers.buffer.com/
# BUFFER_API_KEY=
#
# Live Buffer smoke (tools/buffer-smoke.mts) — opt-in only
# AGENT_DECK_LIVE_BUFFER_TEST=1
# AGENT_DECK_LIVE_BUFFER_WRITE_TEST=1
# BUFFER_SMOKE_CHANNEL_ID=


# Direct account OAuth (local Agent Deck; register exact callback URL in each provider)
# Instagram requires an Instagram professional account + approved app configuration.
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8787/api/social/instagram/oauth/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://127.0.0.1:8787/api/social/x/oauth/callback
# Enable YouTube Data API v3 in the Google project.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8787/api/social/youtube/oauth/callback
# Reddit web app credentials and approved API access.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_REDIRECT_URI=http://127.0.0.1:8787/api/social/reddit/oauth/callback
# REDDIT_USER_AGENT=AgentDeck/0.1 by YOUR_REDDIT_USERNAME

# Cloud Runtime Phase 1 — server-only workspace configuration
# Cloud requires Supabase fs_files plus migrations under supabase/migrations.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AGENT_DECK_ALLOWED_EMAILS=
# GITHUB_TOKEN=  # optional for public repos; required for private read access
# Vercel Functions use request-scoped OIDC automatically.
# External SDK callers can set the following three instead:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
